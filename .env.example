# Real-time Leaderboard API - Environment Variables
# Copy to .env and fill in values

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Docker service name: postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/leaderboard?schema=public

# Redis
# Docker service name: redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Better-Auth
BETTER_AUTH_SECRET=leaderboard-dev-secret-key-must-be-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Optional - Email (for verification)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# EMAIL_FROM=noreply@example.com